{
  "format": "clarify-template/v1",
  "id": "clarify.sample.customer-contact-lookup",
  "version": "0.2.0",
  "title": "Customer contact lookup",
  "category": "forms",
  "description": "Test-data forms layout for Customer, exercising dictionary-driven field types. This generates editable ClarifyDSL; no standalone business behavior is implied.",
  "valueTypes": {
    "money": "NodaMoney.Money",
    "quantities": "UnitsNet",
    "metadata": "dictionary"
  },
  "parameters": [
    {
      "name": "Entity",
      "kind": "entity"
    }
  ],
  "forms": [
    {
      "entity": "Entity",
      "columns": 8,
      "fields": [
        "Email",
        "Name",
        "City"
      ],
      "title": "Customer contact lookup",
      "controls": {
        "Email": {
          "kind": "text",
          "validation": {
            "maxLength": 254
          }
        },
        "City": {
          "kind": "radio",
          "choices": [
            "Los Angeles",
            "Pasadena",
            "Other"
          ]
        }
      }
    }
  ]
}
