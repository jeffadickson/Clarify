@page "/"
@page "/customers"
@inject ICustomerStore Store
@implements IDisposable
<h1>Customers</h1>
<p>Shared ClarifyDSL-generated form running in Blazor Web or Blazor Hybrid.</p>
@if (!string.IsNullOrEmpty(error)) { <p role="alert" style="color:#a21d2e">@error</p> }
@if (busy) { <p>Loading…</p> }
else {
 <div class="clarify-two">
  <section><h2>Browse</h2><button @onclick="NewCustomer">New customer</button>
   <ul>@foreach (var row in customers) {
    <li><button @onclick="() => Select(row.Id)">@row.Name</button> (@row.City)</li>
   }</ul>
   <nav aria-label="Customer pages">
    <button disabled="@(busy || page==0)" @onclick="PreviousPage">Previous</button>
    <span>Page @(page+1)</span>
    <button disabled="@(busy || !hasNext)" @onclick="NextPage">Next</button>
   </nav>
  </section>
  <section><h2>@(model.Id == 0 ? "New customer" : "Edit customer")</h2>
   <EditForm Model="@model" OnValidSubmit="SaveAsync" FormName="customerEditor" @key="model">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <CustomerFields Model="@model" />
    <button type="submit" disabled="@saving">@(saving ? "Saving…" : "Save customer")</button>
   </EditForm>
  </section>
 </div>
}
<style>.clarify-two{display:grid;grid-template-columns:1fr 2fr;gap:2rem}@media(max-width:700px){.clarify-two{grid-template-columns:1fr}}button{padding:.5rem;margin:.25rem}input{padding:.5rem}</style>
@code {
 private CustomerModel model = new();
 private IReadOnlyList<CustomerModel> customers = Array.Empty<CustomerModel>();
 private bool busy = true, saving, hasNext;
 private int page;
 private const int PageSize=25;
 private CancellationTokenSource? browseCancellation;
 private string? error;
 protected override async Task OnInitializedAsync() { await ReloadAsync(); }
 // Cancel obsolete browse requests so a slow earlier page cannot overwrite
 // a newer result. Each EF Core call gets its own DbContext via the store.
 private async Task ReloadAsync() {
  browseCancellation?.Cancel();
  browseCancellation?.Dispose();
  var current=new CancellationTokenSource();
  browseCancellation=current;
  busy=true;
  try {
   var result=await Store.PageAsync(page,PageSize,current.Token);
   if(!current.IsCancellationRequested) {
    customers=result.Items;
    hasNext=result.HasNext;
    error=null;
   }
  } catch(OperationCanceledException) when(current.IsCancellationRequested) {
   // Navigation superseded this request; not a user-visible error.
  } catch(Exception ex) {
   if(!current.IsCancellationRequested)error=ex.Message;
  } finally {
   if(ReferenceEquals(browseCancellation,current))busy=false;
  }
 }
 private async Task NextPage(){if(!hasNext)return;page++;await ReloadAsync();}
 private async Task PreviousPage(){if(page==0)return;page--;await ReloadAsync();}
 public void Dispose(){browseCancellation?.Cancel();browseCancellation?.Dispose();}
 private void NewCustomer(){ model = new(); error=null; }
 private async Task Select(long id) { try { model = await Store.GetAsync(id) ?? new(); error=null; } catch(Exception ex){error=ex.Message;} }
 private async Task SaveAsync() {
  if(saving) return;
  saving=true;
  try { var id=await Store.SaveAsync(model);await ReloadAsync();model=await Store.GetAsync(id) ?? new(); }
  catch(Exception ex){ error=ex.Message; }
  finally { saving=false; }
 }
}
